---
export interface Props {
  intent?: "accent" | "note" | "danger";
  size?: "sm" | "md" | "lg";
}

const { intent = "accent", size = "md" } = Astro.props;
---

<span class:list={["docs-badge", `docs-badge--${intent}`, `docs-badge--${size}`]}>
  <span class="docs-badge__icon"><slot name="icon" /></span>
  <slot />
</span>

<style>
  .docs-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid currentColor;
    border-radius: 0.25rem;
    padding: 0.15rem 0.4rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .docs-badge--accent { color: var(--sl-color-accent-high); }
  .docs-badge--note { color: var(--sl-color-blue-high); }
  .docs-badge--danger { color: var(--sl-color-red-high); }
  .docs-badge--sm { font-size: var(--sl-text-xs); }
  .docs-badge--md { font-size: var(--sl-text-sm); }
  .docs-badge--lg { font-size: var(--sl-text-base); }
  .docs-badge__icon:empty { display: none; }
  .docs-badge__icon :global(svg) { display: block; width: 1em; height: 1em; }
</style>
