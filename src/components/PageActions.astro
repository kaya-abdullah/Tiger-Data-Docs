<div class="page-actions" data-page-actions>
  <button class="copy-markdown" type="button" data-copy-page>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="9" y="9" width="11" height="11" rx="2" />
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
    </svg>
    <span data-copy-label>Copy Markdown</span>
  </button>
  <details>
    <summary aria-label="More page actions">
      <svg aria-hidden="true" viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="m3 4.5 3 3 3-3" />
      </svg>
    </summary>
    <div class="page-actions-menu">
      <button type="button" data-copy-page>Copy page content</button>
      <a href="#" data-ai="chatgpt">Open in ChatGPT</a>
      <a href="#" data-ai="claude">Open in Claude</a>
      <a href="#" data-ai="gemini">Open in Gemini</a>
    </div>
  </details>
</div>

<script>
  function pageText(): string {
    const content = document.querySelector("main .sl-markdown-content");
    return content?.textContent?.replace(/\n{3,}/g, "\n\n").trim() ?? document.title;
  }

  document.querySelectorAll<HTMLElement>("[data-page-actions]").forEach((actions) => {
    actions.querySelectorAll<HTMLButtonElement>("[data-copy-page]").forEach((button) => {
      button.addEventListener("click", async () => {
        await navigator.clipboard.writeText(pageText());
        const label = actions.querySelector<HTMLElement>("[data-copy-label]");
        if (label) {
          label.textContent = "Copied";
          window.setTimeout(() => (label.textContent = "Copy Markdown"), 1600);
        }
        actions.querySelector("details")?.removeAttribute("open");
      });
    });

    actions.querySelectorAll<HTMLAnchorElement>("[data-ai]").forEach((link) => {
      const prompt = encodeURIComponent(`Read and help me understand this documentation page: ${location.href}`);
      const destinations: Record<string, string> = {
        chatgpt: `https://chatgpt.com/?q=${prompt}`,
        claude: `https://claude.ai/new?q=${prompt}`,
        gemini: `https://gemini.google.com/app?prompt=${prompt}`,
      };
      link.href = destinations[link.dataset.ai ?? ""] ?? location.href;
      link.target = "_blank";
      link.rel = "noreferrer";
    });
  });
</script>

<style>
  .page-actions {
    display: inline-flex;
    flex: 0 0 auto;
    height: 32px;
    color: var(--sidebar-nav-text);
    border: 1px solid var(--stl-color-border-faint, var(--sl-color-hairline));
    border-radius: 4px;
  }

  button,
  summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: 30px;
    margin: 0;
    color: inherit;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  button:hover,
  summary:hover {
    background: light-dark(var(--tiger-grey-100), var(--tiger-grey-800));
  }

  .copy-markdown {
    gap: 0.4rem;
    padding: 0 0.65rem;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  details {
    position: relative;
    border-inline-start: 1px solid var(--stl-color-border-faint, var(--sl-color-hairline));
  }

  summary {
    width: 30px;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .page-actions-menu {
    position: absolute;
    z-index: 20;
    top: calc(100% + 6px);
    right: 0;
    display: grid;
    width: 190px;
    padding: 0.35rem;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--stl-color-border-faint, var(--sl-color-hairline));
    border-radius: 4px;
    box-shadow: var(--tiger-shadow-md, 0 10px 24px rgb(0 0 0 / 0.12));
  }

  .page-actions-menu a,
  .page-actions-menu button {
    justify-content: flex-start;
    width: 100%;
    padding: 0 0.55rem;
    color: inherit;
    font: inherit;
    font-size: 0.8125rem;
    text-align: left;
    text-decoration: none;
    border-radius: 3px;
  }

  @media (max-width: 40rem) {
    .page-actions {
      display: none;
    }
  }
</style>
