---
const label = Astro.locals.t("themeSelect.accessibleLabel");
---

<starlight-theme-select class="theme-select">
  <svg aria-hidden="true" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="4" width="18" height="13" rx="2" />
    <path d="M8 21h8M12 17v4" />
  </svg>
  <select aria-label={label} title={label}>
    <option value="dark">{Astro.locals.t("themeSelect.dark")}</option>
    <option value="light">{Astro.locals.t("themeSelect.light")}</option>
    <option value="auto" selected>{Astro.locals.t("themeSelect.auto")}</option>
  </select>
  <svg class="chevrons" aria-hidden="true" viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
    <path d="m3.5 4.75 2.5-2 2.5 2M8.5 7.25 6 9.25l-2.5-2" />
  </svg>
</starlight-theme-select>

<style>
  .theme-select {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem;
    box-sizing: border-box;
    width: 52px;
    height: 34px;
    padding-inline: 7px 5px;
    color: var(--sidebar-nav-text);
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--stl-color-border-faint, var(--sl-color-hairline));
    border-radius: 4px;
  }

  .theme-select:hover {
    background: light-dark(var(--tiger-grey-100), var(--tiger-grey-800));
  }

  select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
    opacity: 0;
  }

  svg {
    pointer-events: none;
  }

  .chevrons {
    width: 11px;
  }
</style>

<script is:inline>
  StarlightThemeProvider.updatePickers();
</script>

<script>
  type Theme = "auto" | "dark" | "light";
  const storageKey = "starlight-theme";
  const parseTheme = (theme: unknown): Theme =>
    theme === "auto" || theme === "dark" || theme === "light" ? theme : "auto";
  const loadTheme = (): Theme => parseTheme(localStorage.getItem(storageKey));
  const systemTheme = (): Theme =>
    matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";

  function updateTheme(theme: Theme): void {
    StarlightThemeProvider.updatePickers(theme);
    document.documentElement.dataset.theme = theme === "auto" ? systemTheme() : theme;
    localStorage.setItem(storageKey, theme === "auto" ? "" : theme);
  }

  if (!customElements.get("starlight-theme-select")) {
    customElements.define(
      "starlight-theme-select",
      class extends HTMLElement {
        connectedCallback() {
          const select = this.querySelector("select");
          const theme = loadTheme();
          if (select) select.value = theme;
          updateTheme(theme);
          select?.addEventListener("change", (event) => {
            if (event.currentTarget instanceof HTMLSelectElement) {
              updateTheme(parseTheme(event.currentTarget.value));
            }
          });
        }
      },
    );
  }

  matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
    if (loadTheme() === "auto") updateTheme("auto");
  });
</script>
